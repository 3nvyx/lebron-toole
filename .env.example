# Copy to .env.local and fill in. Every value is optional.

# Neon pooled connection string (postgres://...-pooler.../neondb?sslmode=require).
# Optional until a Neon project exists: when unset, the app runs on browser
# localStorage only and the HTTP API answers 503 not_connected.
# DATABASE_URL=

# Bearer token agents send as `Authorization: Bearer <token>` (or `x-readme-token`).
# When unset, the API only accepts requests whose Host is localhost.
# README_TOKEN=

# GitHub sign-in. Create an OAuth app at https://github.com/settings/developers
# with callback URL <your origin>/api/auth/github/callback (for local dev:
# http://localhost:3100/api/auth/github/callback). When both are set, the page
# requires a GitHub login and every change is attributed to that GitHub user.
# When unset, the page falls back to a browser-only "Who are you?" prompt.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Comma-separated GitHub logins allowed in. Unset = any GitHub account.
# GITHUB_ALLOWED_USERS=3nvyx,friend-login

# Signs the session cookie. Falls back to GITHUB_CLIENT_SECRET when unset.
# SESSION_SECRET=

# Public origin used to build the OAuth callback URL when the app runs behind a
# proxy. Unset = the request's own origin.
# APP_URL=
